# Copy to .env.local for local development (npm run dev). .env.development already points at http://localhost:8080.
# For deployments the same variables are set by .github/workflows/ci-cd.yml at build time.

# Base URL of the backend API, WITHOUT a trailing slash and without /api (the services add /api/... themselves)
VITE_API_URL=http://localhost:8080

# Stripe publishable key (test mode: pk_test_...). It is public by design; the secret key only lives in the backend.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Public demo helpers: banner with the test card, demo logins on the sign-in page. Leave unset for the regular shop.
# VITE_DEMO_MODE=true
