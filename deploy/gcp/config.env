# Non-secret deployment settings for the Ecommerce frontend (read by .github/workflows/ci-cd.yml).
# Use the same values as deploy/gcp/config.env in the Ecommerce backend repository.
# Project IDs and numbers are identifiers, not credentials: access is controlled by Workload Identity Federation.
# While GCP_PROJECT_ID / GCP_PROJECT_NUMBER / ECOMMERCE_SITE_ID are empty, pushes to master only check and build.
GCP_PROJECT_ID=ilandeka-demos
GCP_PROJECT_NUMBER=608005285168
GCP_REGION=europe-west1
# Firebase Hosting site that serves this app (https://<site>.web.app)
ECOMMERCE_SITE_ID=ilandeka-ecommerce
# Optional: address of the API when it is not the default Cloud Run URL, e.g. https://api.example.com (without /api)
ECOMMERCE_API_URL=
# Stripe PUBLISHABLE key in test mode (pk_test_...). Publishable keys are meant to be public: they sit in every page of
# every shop that uses Stripe. The matching secret key lives only in the backend's Secret Manager. A live key (pk_live_...)
# is refused by the workflow.
STRIPE_PUBLISHABLE_KEY=pk_test_51QfUplF5PwFEYFINTrRW4Rf1hBzVPaGDwFTh2z7YPoHqy2JvMJb3jkDAUgsxFdgOAGzOMeHm3gY6mi8N2TagJ7dZ00NEicZV5q
